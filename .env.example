# Copy to .env (git-ignored) and set a real password.
POSTGRES_USER=scrap
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scrap
# How the backend reaches the database (must match the values above).
DATABASE_URL=postgresql://scrap:change-me@127.0.0.1:5432/scrap
# postgres (default) or memory (no persistence; tests and quick local runs)
SCRAP_STORE=postgres
